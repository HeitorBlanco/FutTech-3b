@page "/comissaotecnica"
@layout Layout.PublicLayout

<section class="comissao-page">
    <div class="comissao-container">
        <div class="comissao-header">
            <h1>Comissão Técnica</h1>
        </div>

        <div class="comissao-card">
            <div class="comissao-profile">
                <img src="images/comissao-heitor.png" alt="Heitor" />
            </div>

            <div class="comissao-text">
                <ul>
                    <li><strong>Heitor Blanco</strong></li>
                    <li>Técnico Treinador</li>
                    <li>17 anos</li>
                    <li>Especialidades: contra-ataque ofensivo e condicionamento.</li>
                </ul>
            </div>
        </div>

        <div class="comissao-gallery">
            <img src="images/comissao-heitor.png" alt="Foto 1" />
            <img src="images/comissao-samuel.png" alt="Foto 2" />
        </div>

        <div class="comissao-card">
            <div class="comissao-profile">
                <img src="images/comissao-samuel.png" alt="Samuel" />
            </div>

            <div class="comissao-text">
                <ul>
                    <li><strong>Samuel Butzke</strong></li>
                    <li>Auxiliar Técnico</li>
                    <li>17 anos</li>
                    <li>Especialidades: táticas defensivas e treino de fundamentos.</li>
                </ul>
            </div>
        </div>
    </div>
</section>
