@page "/financeiro"
@layout Layout.PublicLayout

<div class="header-section">
    <h2>Financeiro</h2>
    <button class="btn-primary" @onclick="PrepareNew">Nova Transação</button>
</div>

<div class="dashboard-cards">
    <div class="card-summary">
        <div class="card-title">Receitas Totais</div>
        <div class="card-value text-success">R$ @TotalReceitas.ToString("F2")</div>
    </div>
    <div class="card-summary">
        <div class="card-title">Despesas Totais</div>
        <div class="card-value text-danger">R$ @TotalDespesas.ToString("F2")</div>
    </div>
    <div class="card-summary">
        <div class="card-title">Saldo Líquido</div>
        <div class="card-value @(Saldo >= 0 ? "text-success" : "text-danger")">R$ @Saldo.ToString("F2")</div>
    </div>
</div>

@if (showForm)
{
    <div class="form-container">
        <h3>Nova Transação</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Descrição</label>
                <input type="text" placeholder="Ex: Mensalidade, Equipamentos" @bind="newTransacao.Descricao" />
            </div>
            <div class="form-group">
                <label>Valor (R$)</label>
                <input type="number" step="0.01" @bind="newTransacao.Valor" />
            </div>
            <div class="form-group">
                <label>Tipo</label>
                <select @bind="newTransacao.Tipo">
                    <option value="Receita">Receita</option>
                    <option value="Despesa">Despesa</option>
                </select>
            </div>
            <div class="form-group">
                <label>Data</label>
                <input type="text" placeholder="Ex: 23/06/2026" @bind="newTransacao.Data" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn-success" @onclick="Save">Salvar</button>
            <button class="btn-secondary" @onclick="Cancel">Cancelar</button>
        </div>
    </div>
}

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Descrição</th>
                <th>Data</th>
                <th>Tipo</th>
                <th>Valor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transacao in transacoes)
            {
                <tr>
                    <td>@transacao.Descricao</td>
                    <td>@transacao.Data</td>
                    <td>
                        <span class="badge @transacao.Tipo.ToLower()">@transacao.Tipo</span>
                    </td>
                    <td class="@(transacao.Tipo == "Receita" ? "val-receita" : "val-despesa")">
                        @(transacao.Tipo == "Receita" ? "+" : "-") R$ @transacao.Valor.ToString("F2")
                    </td>
                    <td>
                        <button class="btn-delete" @onclick="() => DeleteTransacao(transacao.Id)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private bool showForm = false;
    private Transacao newTransacao = new Transacao();

    private List<Transacao> transacoes = new List<Transacao>
    {
        new Transacao { Id = 1, Descricao = "Mensalidades - Sub-11", Valor = 450.00m, Tipo = "Receita", Data = "22/06/2026" },
        new Transacao { Id = 2, Descricao = "Compra de Cones e Coletes", Valor = 180.00m, Tipo = "Despesa", Data = "20/06/2026" },
        new Transacao { Id = 3, Descricao = "Aluguel de Campo Society", Valor = 300.00m, Tipo = "Despesa", Data = "18/06/2026" },
        new Transacao { Id = 4, Descricao = "Mensalidades - Sub-15", Valor = 300.00m, Tipo = "Receita", Data = "15/06/2026" }
    };

    private decimal TotalReceitas => transacoes.Where(t => t.Tipo == "Receita").Sum(t => t.Valor);
    private decimal TotalDespesas => transacoes.Where(t => t.Tipo == "Despesa").Sum(t => t.Valor);
    private decimal Saldo => TotalReceitas - TotalDespesas;

    private void PrepareNew()
    {
        newTransacao = new Transacao { Tipo = "Receita", Data = DateTime.Now.ToString("dd/MM/yyyy") };
        showForm = true;
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(newTransacao.Descricao) || newTransacao.Valor <= 0) return;

        newTransacao.Id = transacoes.Any() ? transacoes.Max(t => t.Id) + 1 : 1;
        transacoes.Add(newTransacao);
        showForm = false;
    }

    private void DeleteTransacao(int id)
    {
        var existing = transacoes.FirstOrDefault(t => t.Id == id);
        if (existing != null)
        {
            transacoes.Remove(existing);
        }
    }

    private void Cancel()
    {
        showForm = false;
    }

    public class Transacao
    {
        public int Id { get; set; }
        public string Descricao { get; set; }
        public decimal Valor { get; set; }
        public string Tipo { get; set; }
        public string Data { get; set; }
    }
}
