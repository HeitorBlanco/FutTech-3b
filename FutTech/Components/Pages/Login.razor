@page "/login"
@layout Layout.PublicLayout

<section class="login-page">

    <div class="login-card">

        <div class="login-left">

            <img src="images/logo.png" alt="FutTech" class="logo" />

            <h2>Bem-vindo!</h2>

            <p>
                Acesse sua conta para gerenciar informações da FutTech.
            </p>

        </div>

        <div class="login-right">

            <h1>Entrar</h1>

            <div class="input-group">
                <label>Email</label>
                <input type="email" placeholder="Digite seu email" />
            </div>

            <div class="input-group">
                <label>Senha</label>
                <input type="password" placeholder="Digite sua senha" />
            </div>

            <button class="btn-login">
                Entrar
            </button>

            <a href="#" class="forgot-password">
                Esqueceu sua senha?
            </a>

        </div>

    </div>

</section>

<style>
    .login-page {
        min-height: calc(100vh - 80px);
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f4f6fb;
        padding: 40px 20px;
    }

    .login-card {
        width: 950px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .login-left {
        width: 40%;
        background: linear-gradient(180deg,#1736C7,#0E1F78);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        text-align: center;
    }

    .logo {
        width: 140px;
        margin-bottom: 25px;
    }

    .login-left h2 {
        font-size: 32px;
        margin-bottom: 15px;
    }

    .login-left p {
        line-height: 28px;
    }

    .login-right {
        width: 60%;
        padding: 50px;
    }

        .login-right h1 {
            color: #1736C7;
            margin-bottom: 35px;
        }

    .input-group {
        margin-bottom: 20px;
    }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .input-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            outline: none;
        }

    .btn-login {
        width: 100%;
        padding: 14px;
        background: #1736C7;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .forgot-password {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #1736C7;
        text-decoration: none;
    }
</style>