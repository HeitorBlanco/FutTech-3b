@page "/responsavel/avaliacoes"

<PageTitle>Avaliações do Atleta</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Responsável"
              CargoUsuario="Responsável"
              TextoPerfil="Responsável"
              Perfil="PerfilUsuario.Responsavel"
              ItemAtivo="avaliacoes"
              TituloMenu="Menu do responsável">
    <main class="guardian-evaluations-content">
        <header class="guardian-heading">
            <div>
                <h1>Avaliações</h1>
                <p>Acompanhe a evolução registrada pelo treinador.</p>
            </div>
        </header>

        <section class="athlete-summary">
            <div class="athlete-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0M12 14v7" />
                </svg>
            </div>
            <div>
                <strong>Nenhum atleta carregado</strong>
                <span>Turma não carregada</span>
                <small>0 avaliações registradas</small>
            </div>
        </section>

        <section class="latest-panel" aria-label="Última avaliação">
            <div class="latest-heading">
                <div>
                    <h2>Última avaliação</h2>
                    <time>Nenhuma avaliação carregada</time>
                </div>
                <div class="latest-score">
                    <span>Média</span>
                    <strong>0,0</strong>
                </div>
            </div>

            <dl class="score-list">
                <div>
                    <dt>Técnica</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Física</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Tática</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Comportamento</dt>
                    <dd>0</dd>
                </div>
            </dl>

            <p>As observações do treinador aparecerão aqui quando o backend for conectado.</p>
        </section>

        <section class="history-panel" aria-label="Histórico de avaliações">
            <div class="section-title">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
                </svg>
                <h2>Histórico</h2>
            </div>

            <div class="empty-state">
                <strong>Nenhuma avaliação publicada</strong>
                <span>Quando o treinador registrar uma avaliação, ela aparecerá aqui.</span>
            </div>
        </section>
    </main>
</AppAreaShell>
