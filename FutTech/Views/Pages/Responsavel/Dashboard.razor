@page "/responsavel/dashboard"

<PageTitle>Área do Responsável</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Responsável"
              CargoUsuario="Responsável"
              TextoPerfil="Responsável"
              Perfil="PerfilUsuario.Responsavel"
              ItemAtivo="atletas"
              TituloMenu="Menu do responsável">
    <main class="portal-content">
        <section class="portal-heading">
            <h1>Meus Atletas</h1>
            <p>Acompanhe os alunos vinculados à sua conta.</p>
        </section>

        <section class="athlete-card">
            <div class="athlete-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0M12 14v7" />
                </svg>
            </div>
            <div>
                <strong>Nenhum atleta carregado</strong>
                <span>Os atletas vinculados aparecerão aqui.</span>
                <small>Dados serão preenchidos pelo backend.</small>
            </div>
        </section>

        <section class="notice-section">
            <div class="section-title">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 11v2h4l10 6V5L7 11H3Zm14 1h4M20 7l-2 2m0 6 2 2" />
                </svg>
                <h2>Comunicados</h2>
            </div>

            <article class="notice-card">
                <div>
                    <strong>Nenhum comunicado publicado</strong>
                    <span>Os avisos aparecerão aqui quando o backend for conectado.</span>
                </div>
            </article>
        </section>
    </main>
</AppAreaShell>
