@page "/login"
@layout PublicLayout
@rendermode InteractiveServer
@using FutTech.Services
@inject DemoAuthService AuthService
@inject NavigationManager Navigation

<section class="login-page">

    <div class="login-card">

        <div class="login-left">

            <img src="images/logo.png" alt="FutTech" class="logo" />

            <h2>Bem-vindo!</h2>

            <p>
                Acesse sua conta para gerenciar informações da FutTech.
            </p>

        </div>

        <div class="login-right">

            <h1>Entrar</h1>

            <form @onsubmit="Entrar" @onsubmit:preventDefault="true">
                <div class="input-group">
                    <label for="email">Email</label>
                    <input id="email" type="email" placeholder="Digite seu email" @bind="Email" />
                </div>

                <div class="input-group">
                    <label for="senha">Senha</label>
                    <input id="senha" type="password" placeholder="Digite sua senha" @bind="Senha" />
                </div>

                @if (!string.IsNullOrWhiteSpace(MensagemErro))
                {
                    <p class="login-error">@MensagemErro</p>
                }

                <button type="submit" class="btn-login">
                    Entrar
                </button>
            </form>

            <a href="/recuperar-senha" class="forgot-password">
                Esqueceu sua senha?
            </a>

        </div>

    </div>

</section>

@code {
    private string Email { get; set; } = string.Empty;
    private string Senha { get; set; } = string.Empty;
    private string MensagemErro { get; set; } = string.Empty;

    private void Entrar()
    {
        var usuario = AuthService.Entrar(Email, Senha);

        if (usuario is null)
        {
            MensagemErro = "Email ou senha incorretos.";
            return;
        }

        Navigation.NavigateTo(usuario.RotaInicial);
    }
}
