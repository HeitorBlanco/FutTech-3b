@page "/treinadores"

@using FutTech.DAO
@using TreinadorModel = FutTech.Models.Treinador

@inject TreinadoresDAO TreinadoresDAO
@inject NavigationManager NavigationManager

<h1>Treinadores</h1>

<div class="mb-3">

    <button class="btn btn-primary"
            @onclick="NovoCadastro">

        Novo Cadastro

    </button>

</div>

<table class="table">

    <thead>

        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Cargo</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var treinador in ListaTreinadores)
        {
            <tr>

                <td>
                    @treinador.Id
                </td>

                <td>
                    @treinador.Nome
                </td>

                <td>
                    @treinador.Cargo
                </td>

                <td>
                    @(treinador.Ativo ? "Sim" : "Não")
                </td>

                <td>

                    <button type="button"
                            class="btn btn-danger btn-sm"
                            @onclick="() => Excluir(treinador.Id)">

                        Excluir

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>

@code {

    private List<TreinadorModel> ListaTreinadores = new();

    protected override void OnInitialized()
    {
        ListaTreinadores = TreinadoresDAO.Listar();
    }

    private void NovoCadastro()
    {
        NavigationManager.NavigateTo("/treinadores/cadastro");
    }

    private void Excluir(int id)
    {
        TreinadoresDAO.Excluir(id);

        ListaTreinadores = TreinadoresDAO.Listar();
    }
}