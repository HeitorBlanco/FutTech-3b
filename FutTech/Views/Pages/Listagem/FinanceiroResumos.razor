@page "/resumofinanceiro"
@rendermode InteractiveServer

@using FutTech.DAO
@using FutTech.Models

@inject FinanceiroResumosDAO FinanceiroResumoDAO
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Resumo Financeiro</h1>
    </div>

    <button class="btn btn-primary"
            @onclick="NovoCadastro">
        <i class="bi bi-plus-lg"></i> Novo Cadastro
    </button>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Recebido no Mês Atual</th>
            <th>Pendentes</th>
            <th>Total a Receber</th>
            <th>Total Pago</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var financeiro in FinanceiroResumo)
        {
            <tr>
                <td>R$ @financeiro.RecebidoMesAtual.ToString("F2")</td>
                <td>@financeiro.Pendentes</td>
                <td>R$ @financeiro.TotalAReceber.ToString("F2")</td>
                <td>R$ @financeiro.TotalPago.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<FinanceiroResumo> FinanceiroResumo = new();

    protected override void OnInitialized()
    {
        FinanceiroResumo = FinanceiroResumoDAO.Listar();
    }

    private void NovoCadastro()
    {
        NavigationManager.NavigateTo("/resumofinanceiro/cadastro");
    }
}