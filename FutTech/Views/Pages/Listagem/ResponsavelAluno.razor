@page "/responsavel-aluno"

@using FutTech.DAO
@using FutTech.Models

@inject ResponsavelAlunoDAO ResponsavelAlunoDAO
@inject NavigationManager NavigationManager

<PageTitle>Responsáveis dos Alunos - FutTech</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Responsáveis dos Alunos</h1>
        <p>Consulta dos responsáveis cadastrados para os alunos.</p>
    </div>

    <div>
        <a href="/responsavel-aluno/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Novo Responsável
        </a>
    </div>

</div>

<div class="table-responsive">

    <table class="table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Usuário</th>
                <th>Aluno</th>
                <th>Parentesco</th>
                <th>Principal</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var responsavel in Responsaveis)
            {
                <tr>
                    <td>@responsavel.Id</td>

                    <td>@responsavel.NomeUsuario</td>

                    <td>@responsavel.NomeAluno</td>

                    <td>@responsavel.Parentesco</td>

                    <td>
                        @(responsavel.Principal ? "Sim" : "Não")
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

@code {

    private List<global::FutTech.Models.ResponsavelAluno> Responsaveis = new();

    protected override void OnInitialized()
    {
        Responsaveis = ResponsavelAlunoDAO.Listar();
    }
}