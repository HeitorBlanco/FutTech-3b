@page "/alunos"

@using FutTech.DAO
@using FutTech.Models

@inject AlunoDAO AlunosDAO

<h1>Alunos</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Responsável</th>
            <th>Data de Nascimento</th>
            <th>Turma</th>
            <th>Ativo</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var aluno in Aluno)
        {
            <tr>
                <td>@aluno.Id</td>
                <td>@aluno.Nome</td>
                <td>@aluno.Responsavel</td>
                <td>@aluno.DataNascimento.ToString("dd/MM/yyyy")</td>
                <td>@aluno.TurmaId</td>
                <td>@(aluno.Ativo ? "Sim" : "Não")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Aluno> Aluno = new();

    protected override void OnInitialized()
    {
        Aluno = AlunosDAO.Listar();
    }
}