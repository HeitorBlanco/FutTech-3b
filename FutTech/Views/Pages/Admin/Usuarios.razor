@page "/admin/usuarios"

<PageTitle>Usuários</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Administrador"
              CargoUsuario="Coordenador"
              TextoPerfil="Administrador"
              Perfil="PerfilUsuario.Administrador"
              ItemAtivo="usuarios"
              TituloMenu="Menu administrativo">
    <main class="users-content">
        <div class="users-heading">
            <div>
                <h1>Usuários</h1>
                <p>Estrutura visual para criação e gestão de acessos.</p>
            </div>
        </div>

        <section class="user-form-panel">
            <h2>Novo acesso</h2>

            <form class="user-form">
                <div class="form-group">
                    <label for="nome">Nome</label>
                    <input id="nome" type="text" placeholder="Nome completo" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input id="email" type="email" placeholder="email@futtech.com" />
                </div>

                <div class="form-group">
                    <label for="senha">Senha</label>
                    <input id="senha" type="text" placeholder="Senha inicial" />
                </div>

                <div class="form-group">
                    <label for="perfil">Perfil</label>
                    <select id="perfil">
                        <option>Treinador</option>
                        <option>Responsável</option>
                    </select>
                </div>

                <button type="button">Criar login</button>
            </form>
        </section>

        <section class="users-table-panel">
            <h2>Acessos cadastrados</h2>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Perfil</th>
                            <th>Cargo</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">Nenhum usuário carregado.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</AppAreaShell>
