@page "/treinador/alunos"

<PageTitle>Alunos do Treinador</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Treinador"
              CargoUsuario="Treinador"
              TextoPerfil="Treinador"
              Perfil="PerfilUsuario.Treinador"
              ItemAtivo="alunos"
              TituloMenu="Menu do treinador">
    <main class="students-content">
        <div class="students-heading">
            <div>
                <h1>Alunos</h1>
                <p>Estrutura visual para cadastro e acompanhamento dos atletas.</p>
            </div>
        </div>

        <section class="student-form-panel">
            <h2>Novo aluno</h2>

            <form class="student-form">
                <div class="form-group">
                    <label for="nome">Nome</label>
                    <input id="nome" type="text" placeholder="Nome do aluno" />
                </div>

                <div class="form-group">
                    <label for="responsavel">Responsável</label>
                    <input id="responsavel" type="text" placeholder="Nome do responsável" />
                </div>

                <div class="form-group">
                    <label for="nascimento">Nascimento</label>
                    <input id="nascimento" type="date" />
                </div>

                <div class="form-group">
                    <label for="turma">Turma</label>
                    <select id="turma">
                        <option>Selecione uma turma</option>
                    </select>
                </div>

                <button type="button">Adicionar aluno</button>
            </form>
        </section>

        <section class="students-table-panel">
            <h2>Atletas cadastrados</h2>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Idade</th>
                            <th>Turma</th>
                            <th>Responsável</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">Nenhum aluno carregado.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</AppAreaShell>
