@page "/treinador/turmas"

<PageTitle>Minhas Turmas</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Treinador"
              CargoUsuario="Treinador"
              TextoPerfil="Treinador"
              Perfil="PerfilUsuario.Treinador"
              ItemAtivo="turmas"
              TituloMenu="Menu do treinador">
    <main class="classes-content">
        <header class="classes-heading">
            <div>
                <h1>Minhas Turmas</h1>
                <span>0 turmas ativas</span>
            </div>

            <a href="/treinador/alunos" class="heading-action">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m11 10v-2a4 4 0 0 0-3-3.87M17 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>Alunos</span>
            </a>
        </header>

        <section class="edit-panel" aria-label="Editar turma">
            <div class="edit-panel-heading">
                <div>
                    <h2>Dados da turma</h2>
                    <span>Estrutura visual preparada para edição pelo backend.</span>
                </div>
            </div>

            <form class="class-form">
                <div class="form-group">
                    <label for="nome-turma">Nome</label>
                    <input id="nome-turma" type="text" placeholder="Nome da turma" />
                </div>

                <div class="form-group">
                    <label for="categoria-turma">Categoria</label>
                    <input id="categoria-turma" type="text" placeholder="Categoria" />
                </div>

                <div class="form-group">
                    <label for="dias-turma">Dias</label>
                    <input id="dias-turma" type="text" placeholder="Dias de treino" />
                </div>

                <div class="form-group">
                    <label for="horario-turma">Horário</label>
                    <input id="horario-turma" type="time" />
                </div>

                <div class="form-actions">
                    <button type="button" class="save-button">Salvar</button>
                    <button type="button" class="remove-button">Remover</button>
                </div>
            </form>
        </section>

        <section class="classes-table-panel" aria-label="Turmas do treinador">
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Horário</th>
                            <th>Dias</th>
                            <th>Alunos</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">Nenhuma turma carregada.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</AppAreaShell>
