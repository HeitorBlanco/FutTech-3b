@page "/treinador/avaliacoes"

<PageTitle>Avaliações dos Alunos</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Treinador"
              CargoUsuario="Treinador"
              TextoPerfil="Treinador"
              Perfil="PerfilUsuario.Treinador"
              ItemAtivo="avaliacoes"
              TituloMenu="Menu do treinador">
    <main class="evaluations-content">
        <header class="evaluations-heading">
            <div>
                <h1>Avaliações</h1>
                <p>Registre a evolução técnica, física, tática e comportamental dos alunos.</p>
            </div>
        </header>

        <section class="evaluation-form-panel" aria-label="Nova avaliação">
            <div class="panel-title">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3 2.7 5.48 6.05.88-4.38 4.27 1.03 6.02L12 16.81 6.6 19.65l1.03-6.02-4.38-4.27 6.05-.88L12 3Z" />
                </svg>
                <h2>Nova avaliação</h2>
            </div>

            <form class="evaluation-form">
                <div class="form-group form-group-wide">
                    <label for="aluno">Aluno</label>
                    <select id="aluno">
                        <option>Selecione um aluno</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="data-avaliacao">Data</label>
                    <input id="data-avaliacao" type="date" />
                </div>

                <div class="score-grid">
                    <div class="score-field">
                        <label for="nota-tecnica">Técnica</label>
                        <input id="nota-tecnica" type="number" min="0" max="10" step="1" />
                    </div>

                    <div class="score-field">
                        <label for="nota-fisica">Física</label>
                        <input id="nota-fisica" type="number" min="0" max="10" step="1" />
                    </div>

                    <div class="score-field">
                        <label for="nota-tatica">Tática</label>
                        <input id="nota-tatica" type="number" min="0" max="10" step="1" />
                    </div>

                    <div class="score-field">
                        <label for="nota-comportamental">Comportamento</label>
                        <input id="nota-comportamental" type="number" min="0" max="10" step="1" />
                    </div>
                </div>

                <div class="form-group form-group-full">
                    <label for="observacoes">Observações</label>
                    <textarea id="observacoes" rows="4" placeholder="Descreva pontos fortes, evolução e próximos focos de treino."></textarea>
                </div>

                <div class="form-footer">
                    <div class="average-preview">
                        <span>Média</span>
                        <strong>0,0</strong>
                    </div>

                    <button type="button" class="save-button">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2ZM7 3v6h8M7 21v-8h10v8" />
                        </svg>
                        <span>Salvar Avaliação</span>
                    </button>
                </div>
            </form>
        </section>

        <section class="evaluations-list-panel" aria-label="Avaliações registradas">
            <div class="panel-title">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
                </svg>
                <h2>Avaliações registradas</h2>
            </div>

            <div class="empty-state">
                <strong>Nenhuma avaliação carregada</strong>
                <span>As avaliações aparecerão aqui quando o backend for conectado.</span>
            </div>
        </section>
    </main>
</AppAreaShell>
