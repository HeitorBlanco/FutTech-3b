@page "/treinador/dashboard"

<PageTitle>Dashboard do Treinador</PageTitle>

<AppAreaShell NomeEscolinha="FutTech"
              NomeUsuario="Treinador"
              CargoUsuario="Treinador"
              TextoPerfil="Treinador"
              Perfil="PerfilUsuario.Treinador"
              ItemAtivo="dashboard"
              TituloMenu="Menu do treinador">
    <main class="coach-content">
        <section class="coach-heading">
            <h1>Dashboard do Treinador</h1>
            <p>Resumo rápido das turmas e atletas.</p>
        </section>

        <section class="coach-grid">
            <article class="summary-card">
                <span>Minhas turmas</span>
                <strong>0</strong>
                <small>Turmas vinculadas aparecerão aqui.</small>
            </article>

            <article class="summary-card">
                <span>Atletas ativos</span>
                <strong>0</strong>
                <small>Alunos cadastrados aparecerão aqui.</small>
            </article>

            <article class="summary-card">
                <span>Presença média</span>
                <strong>0%</strong>
                <small>Presenças registradas aparecerão aqui.</small>
            </article>
        </section>

        <section class="coach-panel">
            <div class="panel-title">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 11l2 2 4-5M5 4h14v17l-7-3-7 3V4Z" />
                </svg>
                <h2>Próximo treino</h2>
            </div>

            <div class="training-row">
                <div>
                    <strong>Nenhum treino carregado</strong>
                    <span>O backend preencherá esta informação.</span>
                </div>
            </div>
        </section>
    </main>
</AppAreaShell>
