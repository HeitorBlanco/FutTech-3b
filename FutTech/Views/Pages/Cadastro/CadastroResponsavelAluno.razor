@page "/responsavel-aluno/cadastro"
@rendermode InteractiveServer

@using FutTech.DAO
@using FutTech.Models

@inject ResponsavelAlunoDAO ResponsavelAlunoDAO
@inject UsuariosSistemaDAO UsuariosDAO
@inject AlunoDAO AlunosDAO
@inject NavigationManager NavigationManager

<PageTitle>Novo Responsável - FutTech</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Cadastro de Responsável</h2>
        <p class="text-muted">
            Cadastre um responsável para um aluno da escolinha.
        </p>
    </div>

</div>

<div class="custom-table-card p-4">

    <EditForm Model="responsavel" OnValidSubmit="Salvar">

        <DataAnnotationsValidator />

        <ValidationSummary class="alert alert-danger" />

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Usuário
                </label>

                <InputSelect class="form-select"
                             @bind-Value="responsavel.UsuarioId">

                    <option value="0">
                        Selecione um usuário
                    </option>

                    @foreach (var usuario in Usuarios)
                    {
                        <option value="@usuario.Id">
                            @usuario.Nome
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="() => responsavel.UsuarioId" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Aluno
                </label>

                <InputSelect class="form-select"
                             @bind-Value="responsavel.AlunoId">

                    <option value="0">
                        Selecione um aluno
                    </option>

                    @foreach (var aluno in Alunos)
                    {
                        <option value="@aluno.Id">
                            @aluno.Nome
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="() => responsavel.AlunoId" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Parentesco
                </label>

                <InputText class="form-control"
                           @bind-Value="responsavel.Parentesco"
                           placeholder="Ex.: Pai, Mãe, Avó, Responsável" />

                <ValidationMessage For="() => responsavel.Parentesco" />

            </div>

            <div class="col-md-6 mb-3">

                <div class="form-check mt-4">

                    <InputCheckbox class="form-check-input"
                                   @bind-Value="responsavel.Principal" />

                    <label class="form-check-label">
                        Responsável principal
                    </label>

                </div>

            </div>

        </div>

        <div class="d-flex gap-2 mt-3">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Cadastrar

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Voltar">

                Cancelar

            </button>

        </div>

    </EditForm>

</div>

@code {

    private ResponsavelAluno responsavel = new()
    {
        Principal = false
    };

    private List<global::FutTech.Models.UsuarioSistema> Usuarios = new();

    private List<Aluno> Alunos = new();

    protected override void OnInitialized()
    {
        Usuarios = UsuariosDAO.Listar();

        Alunos = AlunosDAO.Listar();
    }

    private void Salvar()
    {
        ResponsavelAlunoDAO.Inserir(responsavel);

        NavigationManager.NavigateTo("/responsavel-aluno");
    }

    private void Voltar()
    {
        NavigationManager.NavigateTo("/responsavel-aluno");
    }
}