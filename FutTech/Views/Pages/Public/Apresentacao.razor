@page "/apresentacao"
@layout PublicLayout

<section class="pricing-page">
    <div class="pricing-shell">
        <div class="pricing-copy">
            <span class="eyebrow">Planos FutTech</span>

            <h1>
                Gestao completa para escolinhas de futebol.
            </h1>

            <p>
                Organize alunos, turmas, treinadores e responsaveis em um painel simples
                para a rotina da sua escolinha.
            </p>
        </div>

        <article class="price-card">
            <div class="plan-top">
                <div>
                    <span class="plan-label">Plano Escolinha</span>
                    <h2>Essencial</h2>
                </div>

                <span class="badge">SaaS</span>
            </div>

            <div class="price">
                <span>R$</span>
                <strong>119,90</strong>
                <small>/ mes</small>
            </div>

            <ul class="features">
                <li>Cadastro de alunos e responsaveis</li>
                <li>Controle de turmas e treinadores</li>
                <li>Painel administrativo da escolinha</li>
                <li>Suporte inicial para configuracao</li>
            </ul>

            <a class="plan-action" href="/cadastro-escolinha">
                Cadastrar escolinha
            </a>
        </article>
    </div>
</section>
