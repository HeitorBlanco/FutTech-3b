@page "/apresentacao"
@layout PublicLayout

<section class="pricing-page">

    <div class="pricing-header">
        <h1>FutTech: Planos e Preços</h1>
        <p>Já ajudamos mais de 100 mil escolinhas a saírem do caos e a crescerem com segurança.</p>
    </div>

    <div class="plans-grid">

        <!-- Básico -->
        <article class="plan-card">
            <div class="plan-icon">⚽</div>

            <h2>Básico</h2>
            <p class="subtitle">O essencial para começar</p>

            <div class="price">
                <strong>R$ 100,00</strong>
                <span>/mês</span>
            </div>

            <ul>
                <li>✔ Controle de Alunos</li>
                <li>✔ Gestão de Turmas</li>
                <li>✔ Registro de Presença</li>
                <li>✔ Relatórios Básicos</li>
            </ul>

            <a href="/cadastro-escolinha" class="plan-button">
                Escolher Plano
            </a>
        </article>

        <!-- Pro -->
        <article class="plan-card featured">

            <div class="popular">MAIS POPULAR</div>

            <div class="plan-icon">🏆</div>

            <h2>Pro</h2>
            <p class="subtitle">O plano ideal para sua escolinha</p>

            <div class="price">
                <strong>R$ 150,00</strong>
                <span>/mês</span>
            </div>

            <ul>
                <li>✔ Tudo do Básico</li>
                <li>✔ Controle Financeiro</li>
                <li>✔ Comunicação com Pais</li>
                <li>✔ Avaliação de Desempenho</li>
                <li>✔ Relatórios Avançados</li>
            </ul>

            <a href="/cadastro-escolinha" class="plan-button">
                Escolher Plano
            </a>
        </article>

        <!-- Elite -->
        <article class="plan-card">

            <div class="plan-icon">👑</div>

            <h2>Elite</h2>
            <p class="subtitle">Pra quem quer ir mais longe</p>

            <div class="price">
                <strong>R$ 200,00</strong>
                <span>/mês</span>
            </div>

            <ul>
                <li>✔ Tudo do Pro</li>
                <li>✔ Site personalizado</li>
                <li>✔ Agenda de jogos e eventos</li>
                <li>✔ Gestão de Uniformes</li>
                <li>✔ Suporte Prioritário</li>
            </ul>

            <a href="/cadastro-escolinha" class="plan-button">
                Escolher Plano
            </a>
        </article>

    </div>

</section>