@page "/comissaotecnica"
@layout PublicLayout

<section class="comissao">

    <div class="hero">
        <div class="hero-text">
            <span class="titulo-menor">FUTTECH</span>

            <h1>
                Nossa<br />
                Comissão Técnica
            </h1>

            <p>
                Conheça os profissionais responsáveis por desenvolver nossos atletas,
                trabalhando técnica, disciplina e evolução dentro e fora de campo.
            </p>

            <a href="/contato" class="btn-contato">
                Entre em Contato
            </a>
        </div>

        <div class="hero-img">
            <img src="images/comissao-heitor.png" alt="Equipe Técnica">
        </div>
    </div>


    <div class="card-comissao">

        <div class="perfil">
            <img src="images/comissao-heitor.png" alt="Heitor">
        </div>

        <div class="informacoes">

            <h2>Heitor Blanco</h2>

            <h4>Técnico Treinador</h4>

            <p>
                Atua no desenvolvimento técnico dos atletas, focando no
                contra-ataque ofensivo, condicionamento físico e evolução
                individual.
            </p>

            <span>17 anos</span>

        </div>

    </div>


    <div class="galeria">

        <img src="images/comissao-heitor.png">
        <img src="images/comissao-samuel.png">

    </div>


    <div class="card-comissao invertido">

        <div class="informacoes">

            <h2>Samuel Butzke</h2>

            <h4>Auxiliar Técnico</h4>

            <p>
                Responsável pelo apoio tático da equipe, auxiliando no treino
                de fundamentos e na organização defensiva dos atletas.
            </p>

            <span>17 anos</span>

        </div>

        <div class="perfil">
            <img src="images/comissao-samuel.png">
        </div>

    </div>

</section>
