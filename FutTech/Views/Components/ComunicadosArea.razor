<main class="announcements-content">
    <header class="announcements-heading">
        <div>
            <h1>Comunicados</h1>
            <span>0 comunicados publicados</span>
        </div>

        @if (PodeGerenciar)
        {
            <button type="button" class="new-button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                <span>Novo Comunicado</span>
            </button>
        }
    </header>

    @if (PodeGerenciar)
    {
        <section class="announcement-form-panel" aria-label="Novo comunicado">
            <div class="form-heading">
                <div>
                    <h2>Novo comunicado</h2>
                    <span>Publique um aviso para os usuários da escolinha.</span>
                </div>
            </div>

            <form class="announcement-form">
                <div class="form-group">
                    <label for="titulo-comunicado">Título</label>
                    <input id="titulo-comunicado" type="text" placeholder="Título do comunicado" />
                </div>

                <div class="form-group">
                    <label for="categoria-comunicado">Categoria</label>
                    <input id="categoria-comunicado" type="text" placeholder="Geral" />
                </div>

                <div class="form-group full">
                    <label for="conteudo-comunicado">Mensagem</label>
                    <textarea id="conteudo-comunicado" placeholder="Escreva a mensagem"></textarea>
                </div>

                <button type="button">Publicar</button>
            </form>
        </section>
    }

    <section class="announcement-list" aria-label="Lista de comunicados">
        <article class="empty-card">
            <strong>Nenhum comunicado publicado</strong>
            <span>Os avisos aparecerão aqui quando o backend for conectado.</span>
        </article>
    </section>
</main>

@code {
    [Parameter] public bool PodeGerenciar { get; set; }
}
